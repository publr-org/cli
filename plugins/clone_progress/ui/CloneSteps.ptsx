import { Publr } from "publr-jsx";
import type { ViewCtx } from "@publr/admin/Document.ptsx";
import { Button } from "@publr/ui/Button.ptsx";
import { Callout } from "@publr/ui/Callout.ptsx";
import { Icon } from "@publr/ui/Icon.ptsx";
import { Progress } from "@publr/ui/Progress.ptsx";
import { Text } from "@publr/ui/Text.ptsx";

type Mark = { label: string; at: string; span: string; start: number; width: number; bytes: number };

/** Where the clone is, as `clone_progress.state` answers it. */
type Progressed = {
  phase: string;
  /** How far the site is packing it, in ten-thousandths. */
  packed_through: number;
  done_bytes: number;
  total_bytes: number;
  placeholders: number;
  media: boolean;
  problem: string;
  elapsed_ms: number;
  unpacked_bytes: number;
  database_bytes: number;
  media_files: number;
  media_bytes: number;
  /** `down` (a clone) or `up` (a deploy to Cloud). */
  direction: string;
  /** Up, once done: where it is live, and its admin signed in once. */
  address: string;
  admin: string;
};

export type CloneStepsProps = {
  /** The bar's parts as the site weighs them, with media and without. */
  marks_all: Mark[];
  marks_setup: Mark[];
  ctx: ViewCtx;
};

const sized = (bytes: number) =>
  bytes >= 1048576 ? `${(bytes / 1048576).toFixed(1)} MB` : `${Math.max(1, Math.round(bytes / 1024))} KB`;

const clock = (ms: number) => {
  const seconds = Math.floor(ms / 1000);
  const pad = (value: number) => `${value}`.padStart(2, "0");
  return `${pad(Math.floor(seconds / 3600))}:${pad(Math.floor(seconds / 60) % 60)}:${pad(seconds % 60)}`;
};

/** A call that never reached a server (the clone's server stopped, the site's not up yet),
 * as browsers say it; any other refusal is a server answering. */
const unreached = (error: unknown) => /fetch|load failed|network/i.test(String((error as Error)?.message ?? error));

/** Where the clone is: the headline and its time, the bar, the choice of what comes down, and
 * the way into the site once its own server answers. */
export function CloneSteps({ marks_all, marks_setup, ctx }: CloneStepsProps) {
  const state = Publr.reactive({
    phase: "packing",
    packed_through: 0,
    done_bytes: 0,
    total_bytes: 0,
    placeholders: 0,
    unpacked_bytes: 0,
    media: true,
    problem: "",
    elapsed_ms: 0,
    /** The site's own server answers (down) or Cloud made it live (up): the page can open it. */
    here: false,
    /** `up` while the site goes up to Cloud. */
    up: false,
    /** One answer came: which way the site moves is known. */
    known: false,
    address: "",
    admin: "",
    asking: false,
    /** What the page shows, kept here as values so the page redraws when they change. */
    percent: 0,
    width: "0%",
    headline: "",
    timer: "00:00:00",
    downloaded: "",
    /** The two ways to bring the site down, with what each weighs; while choosing. */
    everything: "",
    setup_only: "",
    choosing: false,
    /** The bar's parts, as the clone weighed them: with media and without. */
    layout_all: marks_all ?? [],
    layout_setup: marks_setup ?? [],
  });
  const read = ctx.call("clone_progress.state");
  const chose = ctx.call("clone_progress.choose");

  const layout = (): Mark[] => (state.media ? state.layout_all : state.layout_setup);

  /** How far through the site's bytes the clone is, in one pass: a third of the way while the
   * site packs it, a third while it downloads, the last third while it unpacks. */
  const through = () => {
    if (state.up) {
      // Up: packing here is the first tenth, the upload the most of it, Cloud the rest.
      const sent = state.total_bytes > 0 ? state.done_bytes / state.total_bytes : 0;
      if (state.here) return 1;
      if (state.phase === "uploading") return 0.1 + sent * 0.8;
      if (state.phase === "going_live") return 0.95;
      return 0.05;
    }
    if (state.here || state.phase === "placeholders" || state.phase === "starting") return 1;
    const total = layout().reduce((sum, mark) => sum + mark.bytes, 0);
    const downloaded = state.total_bytes > 0 ? state.done_bytes / state.total_bytes : 0;
    if (state.phase === "packing") return Math.min(1, state.packed_through / 10000) / 3;
    if (state.phase === "downloading") return 1 / 3 + downloaded / 3;
    if (state.phase === "unpacking" && total > 0) return 2 / 3 + Math.min(1, state.unpacked_bytes / total) / 3;
    return 0;
  };

  /** Where on the bar `through` lands, and the part it is in: each part fills its own stretch. */
  const landing = () => {
    const marks = layout();
    const total = marks.reduce((sum, mark) => sum + mark.bytes, 0);
    if (total === 0) return { at: through() * 100, part: "" };
    let left = through() * total;
    for (const mark of marks) {
      if (left <= mark.bytes) return { at: mark.start + (mark.width * left) / mark.bytes, part: mark.label };
      left -= mark.bytes;
    }
    return { at: 100, part: marks[marks.length - 1].label };
  };

  const share = () => (state.here ? 100 : Math.min(99, landing().at));

  const doing = () => {
    if (state.here) return Publr.t("Done");
    if (state.phase === "failed") return Publr.t("It stopped");
    if (state.up) {
      if (state.phase === "uploading") return Publr.t("Uploading");
      if (state.phase === "going_live") return Publr.t("Going live on Cloud");
      return Publr.t("Packing it here");
    }
    if (state.phase === "choosing") return Publr.t("What should come down?");
    if (state.phase === "packing") return Publr.t("Packing it on its server");
    if (state.phase === "downloading") {
      const part = landing().part;
      return part === "" ? Publr.t("Downloading") : Publr.t("Downloading {part}", { part: part.toLowerCase() });
    }
    if (state.phase === "unpacking") {
      const part = landing().part;
      return part === "" ? Publr.t("Unpacking it into this folder") : Publr.t("Unpacking {part}", { part: part.toLowerCase() });
    }
    if (state.phase === "placeholders") return Publr.t("Writing placeholders for media");
    return Publr.t("Starting it here");
  };

  /** Every shown value from the state the clone answered. */
  const show = () => {
    const whole = share();
    state.percent = Math.round(whole);
    state.width = `${whole}%`;
    state.headline = state.phase === "choosing" || state.phase === "failed" ? doing() : `${state.percent}% · ${doing()}`;
    state.timer = state.here
      ? state.up
        ? Publr.t("Deployed in {time}", { time: clock(state.elapsed_ms) })
        : Publr.t("Pulled in {time}", { time: clock(state.elapsed_ms) })
      : Publr.t("Time elapsed {time}", { time: clock(state.elapsed_ms) });
    state.downloaded = (state.phase === "downloading" || state.phase === "uploading") && state.total_bytes > 0
      ? Publr.t("{done} of {total} MB", {
          done: (state.done_bytes / 1048576).toFixed(1),
          total: (state.total_bytes / 1048576).toFixed(1),
        })
      : "";
  };

  /** What comes down, said to the clone; it starts as soon as it hears. */
  const choose = async (media: string) => {
    state.choosing = false;
    state.media = media === "all";
    state.phase = "packing";
    show();
    await chose({ media });
  };
  const take_all = () => {
    void choose("all");
  };
  const take_setup = () => {
    void choose("none");
  };
  /** Up, once done: the live site, and its admin signed in once, each in a window of its own. */
  const open_live = () => {
    window.open(state.address, "_blank");
  };
  const open_admin = () => {
    window.open(state.admin, "_blank");
  };

  /** The clone's own server stops once the site is in its folder, and the site's own server
   * takes the address: until a server answers again it is starting; then it is here. */
  const hand_over = async () => {
    for (let attempt = 0; attempt < 240; attempt += 1) {
      // A refused call answers nothing and keeps why on the call.
      const answered = await read({});
      if (answered === undefined && !unreached(read.error)) {
        state.here = true;
        show();
        return;
      }
      await new Promise((resolve) => window.setTimeout(resolve, 500));
    }
  };

  const follow = async () => {
    const ticking = window.setInterval(() => {
      if (state.here || state.phase === "failed" || state.phase === "choosing") return;
      state.elapsed_ms += 250;
      show();
    }, 250);
    for (;;) {
      try {
        const answered = (await read({})) as { clone: Progressed; marks_all: Mark[]; marks_setup: Mark[] } | undefined;
        if (answered === undefined) throw read.error;
        const found = answered.clone;
        state.layout_all = answered.marks_all;
        state.layout_setup = answered.marks_setup;
        state.phase = found.phase;
        state.packed_through = found.packed_through;
        state.done_bytes = found.done_bytes;
        state.total_bytes = found.total_bytes;
        state.placeholders = found.placeholders;
        state.unpacked_bytes = found.unpacked_bytes;
        state.media = found.media;
        state.problem = found.problem;
        state.up = found.direction === "up";
        state.known = true;
        state.address = found.address;
        state.admin = found.admin;
        if (found.phase === "choosing" && !state.choosing && state.everything === "") {
          state.choosing = true;
          state.everything = Publr.t("Everything · {size}", {
            size: sized(found.database_bytes + found.media_bytes),
          });
          state.setup_only = found.media_files > 0
            ? Publr.t("Database and setup · {size}, {count} images as placeholders", {
                size: sized(found.database_bytes),
                count: `${found.media_files}`,
              })
            : Publr.t("Database and setup · {size}", { size: sized(found.database_bytes) });
        }
        state.elapsed_ms = found.elapsed_ms;
        if (state.up && found.phase === "done") state.here = true;
        show();
        if (found.phase === "failed" || (state.up && found.phase === "done")) break;
        if (found.phase === "starting") {
          await hand_over();
          break;
        }
      } catch {
        // The clone's server stopped answering: it is handing over to the site's server.
        // Up, the page's own server stays until the end has been shown; and before any
        // answer, which way is not known yet: asked again.
        if (!state.up && (state.known || !unreached(read.error))) {
          await hand_over();
          break;
        }
      }
      await new Promise((resolve) => window.setTimeout(resolve, 300));
    }
    window.clearInterval(ticking);
  };

  // Once, when the page is shown: a plain flag, so the effect reads nothing it writes.
  let started = false;
  Publr.effect(() => {
    if (started) return;
    started = true;
    void follow();
  });

  return (
    <div class="flex flex-col gap-5" data-part="clone-progress">
      <div class="flex items-end justify-between gap-4">
        <div class="flex items-center gap-2">
          {!state.here && !state.choosing && state.phase !== "failed" && (
            <Icon name="sync" size="sm" classes="shrink-0 animate-spin" />
          )}
          <Text as="p" variant="heading-md">
            {state.headline}
          </Text>
        </div>
        <Text as="p" variant="body-sm" tone="muted">
          {state.timer}
        </Text>
      </div>
      <div hidden={!state.media}>
        <Progress value={state.percent} max={100} width={state.width} label="" size="lg" marks={state.layout_all} />
      </div>
      <div hidden={state.media}>
        <Progress value={state.percent} max={100} width={state.width} label="" size="lg" marks={state.layout_setup} />
      </div>
      {state.choosing && (
        <div class="flex flex-col gap-2 sm:flex-row">
          <Button type="button" hierarchy="primary" size="md" onClick={take_all}>
            {state.everything}
          </Button>
          <Button type="button" hierarchy="secondary" size="md" onClick={take_setup}>
            {state.setup_only}
          </Button>
        </div>
      )}
      {state.downloaded !== "" && (
        <Text as="p" variant="body-sm" tone="muted">
          {state.downloaded}
        </Text>
      )}
      {!state.media && state.placeholders > 0 && (
        <Text as="p" variant="body-sm" tone="muted">
          {Publr.t("{count} placeholders stand in for media; your real files stay on the server.", {
            count: `${state.placeholders}`,
          })}
        </Text>
      )}
      {state.here && !state.up && (
        <div class="flex justify-end">
          <Button href="/admin" hierarchy="primary" size="md">
            {Publr.t("Open your site")}
          </Button>
        </div>
      )}
      {state.here && state.up && (
        <div class="flex justify-end gap-2">
          <Button type="button" hierarchy="secondary" size="md" onClick={open_live}>
            {Publr.t("Open on Cloud")}
          </Button>
          <Button type="button" hierarchy="primary" size="md" onClick={open_admin}>
            {Publr.t("Open admin")}
          </Button>
        </div>
      )}
      {state.phase === "failed" && <Callout tone="error" title={state.problem} />}
    </div>
  );
}
